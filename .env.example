# ---------------------------------------------------------------------------
# FixMate backend environment template
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Use a dedicated database for production, e.g. fixmate.
# Automated tests create and clean their own fixmate_test_* database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=fixmate

# BetterAuth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of this backend (must match the deployed API origin).
BETTER_AUTH_URL=http://localhost:5000

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra allowed origins.
CORS_ORIGINS=

# Stripe (optional for local development; required for live checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional overrides. Defaults are:
# PAYMENT_SUCCESS_URL=${FRONTEND_URL}/payment/success?session_id={CHECKOUT_SESSION_ID}
# PAYMENT_CANCEL_URL=${FRONTEND_URL}/payment/cancel
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# ImgBB (optional; profile image upload returns 503 when missing)
IMGBB_API_KEY=

# Seed data
# Passwords are read only from the environment and are never stored in Git.
ADMIN_NAME=FixMate Admin
ADMIN_EMAIL=admin@fixmate.local
ADMIN_PASSWORD=
SEED_PASSWORD=
SEED_TECHNICIAN_1_NAME=Rahim Uddin
SEED_TECHNICIAN_1_EMAIL=technician1@fixmate.local
SEED_TECHNICIAN_2_NAME=Karim Hossain
SEED_TECHNICIAN_2_EMAIL=technician2@fixmate.local
SEED_CUSTOMER_NAME=Nusrat Jahan
SEED_CUSTOMER_EMAIL=customer@fixmate.local
# Seeding refuses to run when NODE_ENV=production unless this is explicitly true.
SEED_ALLOW_PRODUCTION=false

# Tests
# Keep the generated test database after a run when set to true.
TEST_KEEP_DB=false
# Run checkout tests against a real Stripe test key when set to true.
RUN_STRIPE_LIVE_TESTS=false
